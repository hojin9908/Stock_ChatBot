# .env는 키 입력 양식으로 저장소에 포함되어 있다.
# 키를 넣은 뒤에는 `git update-index --skip-worktree .env`로 변경 사항이 올라가지 않게 한다.

# 원자료 캐시 (용량이 크고 팀원마다 직접 만든다)
Data_call/cache/
# 실행 중 생기는 파일
__pycache__/
*.pyc
*.tmp
Results/_cost_log.json
Validation/_extract_cache.json
Validation/_safety_judge_cache.json

# 파이썬 가상환경
.venv/
venv/
